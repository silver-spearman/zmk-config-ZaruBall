//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define ADJUST   4
#define SCROLL   2
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&trackball_listener {
    input-processors = <
                         &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                         &zip_temp_layer MOUSE 500
    >;

    scroller {
        layers = <SCROLL>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_xy_scaler 1 20
                            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};

/ {
    behaviors {
        jp_en_tog_or_fn: jp_en_tog_or_fn {
            compatible = "zmk,behavior-hold-tap";
            label = "JPEN_TOG_FN";

            /* ここが必須 */

            bindings = <&mo>, <&tog>;

            /* この hold-tap は「2引数」を取る */

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred"; /* 任意（好みで） */
        };

        // 2 / " （JP配列では Shift+2 が "）

        number2_dquote: number2_dquote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_2>, <&kp JP_DQUOTE>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // 6 / & （JP配列では Shift+6 が &）

        number6_ampersand: number6_ampersand {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_6>, <&kp JP_AMPERSAND>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // 7 / ' （JP配列では Shift+7 が '）

        number7_quote: number7_quote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_7>, <&kp JP_QUOTE>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // 8 / ( （JP配列では Shift+8 が (）

        number8_lparen: number8_lparen {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_8>, <&kp JP_LPAREN>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // 9 / ) （JP配列では Shift+9 が )）

        number9_rparen: number9_rparen {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_9>, <&kp JP_RPAREN>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // 既存：US バックスラッシュ キーで ¥ / | を出す

        backslash_pipe: backslash_pipe {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_YEN>, <&kp JP_PIPE>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // - / = （JP配列では Shift+Minus が =）

        minus_equal: minus_equal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;

            // 通常: - , Shift時: =

            bindings = <&kp MINUS>, <&kp JP_EQUAL>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // ^ / ~ （JP配列の「^/~」キー相当）

        caret_tilde: caret_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;

            // 通常: ^ , Shift時: ~

            bindings = <&kp JP_CARET>, <&kp JP_TILDE>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // @ / ` （JP配列では @ と ` が同じキーに乗っている）

        at_backquote: at_backquote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;

            // 通常: @ , Shift時: `

            bindings = <&kp JP_AT>, <&kp JP_BACKQUOTE>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // ; / + （JP配列では Shift+; が +）

        semicolon_plus: semicolon_plus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>, <&kp JP_PLUS>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // : / * （JP配列の「:/*」キー相当）

        colon_asterisk: colon_asterisk {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;

            // 通常: : , Shift時: *

            bindings = <&kp JP_COLON>, <&kp JP_ASTERISK>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // [ / { （JP配列での [ / { のペア）

        lbracket_lbrace: lbracket_lbrace {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;

            // 通常: [ , Shift時: {

            bindings = <&kp JP_LBRACKET>, <&kp JP_LBRACE>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // ] / } （JP配列での ] / } のペア）

        rbracket_rbrace: rbracket_rbrace {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;

            // 通常: ] , Shift時: }

            bindings = <&kp JP_RBRACKET>, <&kp JP_RBRACE>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // 必要なら、_ 専用キー（Shift有無で同じ挙動）

        underscore_only: underscore_only {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;

            // 通常/Shift時ともに _

            bindings = <&kp JP_UNDERSCORE>, <&kp JP_UNDERSCORE>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo RAISE>, <&mo MOUSE>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo RAISE>, <&mo MOUSE>;
        };

        // Customed Hold-Tap for SandS

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog MOUSE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl MOUSE>;

            label = "MKP_EXIT_AML";
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        japanese_layer {
            display-name = "JP";
            sensor-bindings = <&scroll_up_down>;
            bindings = <
&kp GRAVE             &kp N1      &number2_dquote  &kp N3        &kp N4        &kp N5                           &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                        &number6_ampersand  &number7_quote  &number8_lparen  &number9_rparen  &kp N0           &minus_equal
&kp TAB               &kp Q       &kp W            &kp E         &kp R         &kp T                            &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                      &kp Y               &kp U           &kp I            &kp O            &kp P            &at_backquote
&kp LCTRL             &kp A       &kp S            &kp D         &kp F         &kp G        &caret_tilde        &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &lbracket_lbrace  &kp H               &kp J           &kp K            &kp L            &semicolon_plus  &colon_asterisk
&kp LSHFT             &kp Z       &kp X            &kp C         &kp V         &kp B        &backslash_pipe     &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &rbracket_rbrace  &kp N               &kp M           &kp COMMA        &kp DOT          &kp FSLH         &underscore_only
&jp_en_tog_or_fn 2 1  &kp C_MUTE                   &kp LEFT_GUI  &kp LEFT_ALT  &lt 3 SPACE  &kp INT_MUHENKAN                                                            &kp BACKSPACE     &kp ENTER                                                                              &kp ESCAPE
            >;
        };

        english_layer {
            display-name = "EN";
            sensor-bindings = <&scroll_up_down>;
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5            &trans  &trans  &trans  &trans                       &kp N6  &kp N7  &kp N8     &kp N9      &kp N0            &kp MINUS
&trans  &kp Q   &kp W   &kp E   &kp R   &kp T             &trans  &trans  &trans  &trans                       &kp Y   &kp U   &kp I      &kp O       &kp P             &kp EQUAL
&trans  &kp A   &kp S   &kp D   &kp F   &kp G   &trans    &trans  &trans  &trans  &trans    &kp LEFT_BRACKET   &kp H   &kp J   &kp K      &kp L       &kp SINGLE_QUOTE  &kp SEMICOLON
&trans  &kp Z   &kp X   &kp C   &kp V   &kp B   &trans    &trans  &trans  &trans  &trans    &kp RIGHT_BRACKET  &kp N   &kp M   &kp COMMA  &kp PERIOD  &kp SLASH         &lt SCROLL BACKSLASH
&trans  &trans          &trans  &trans  &trans  &trans                                      &trans             &trans                                                   &trans
            >;
        };

        function_layer {
            display-name = "Fn";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &kp F1     &kp F2  &kp F3  &kp F4  &kp F5             &trans  &trans  &trans  &trans              &kp F6  &kp F7       &kp F8    &kp F9         &kp F10  &kp F11
&trans  &none      &none   &none   &none   &none              &trans  &trans  &trans  &trans              &none   &kp PAGE_UP  &kp UP    &kp PAGE_DOWN  &none    &kp F12
&trans  &none      &none   &none   &none   &none   &none      &trans  &trans  &trans  &trans    &kp LPAR  &none   &kp LEFT     &kp DOWN  &kp RIGHT      &none    &none
&trans  &none      &none   &none   &none   &none   &kp DEL    &trans  &trans  &trans  &trans    &kp RPAR  &none   &kp HOME     &none     &kp END        &none    &none
&trans  &kp RSHFT          &trans  &trans  &trans  &trans                                       &kp DEL   &trans                                                 &kp CAPSLOCK
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                &trans  &trans  &trans  &trans            &none    &none     &none     &none     &none  &none
&trans  &none         &none         &none         &none         &none                       &trans  &trans  &trans  &trans            &none    &none     &none     &none     &none  &none
&trans  &none         &none         &none         &none         &none         &bt BT_CLR    &trans  &trans  &trans  &trans    &none   &none    &mkp MB1  &mkp MB3  &mkp MB2  &none  &none
&trans  &none         &none         &none         &none         &none         &none         &trans  &trans  &trans  &trans    &none   &none    &none     &none     &none     &none  &none
&trans  &none                       &trans        &trans        &trans        &trans                                          &trans  &kp DEL                                       &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                &trans  &trans  &trans  &trans              &bt BT_CLR_ALL  &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none                       &trans  &trans  &trans  &trans              &bt BT_CLR      &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &bt BT_CLR    &trans  &trans  &trans  &trans    &ind_bat  &out OUT_TOG    &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none         &trans  &trans  &trans  &trans    &ind_con  &studio_unlock  &none  &none  &none  &none  &none
&trans  &kp C_MUTE                  &trans        &trans        &trans        &trans                                          &trans    &kp DEL                                     &trans
            >;
        };

        // Extra layer can be added in ZMK STUDIO

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
